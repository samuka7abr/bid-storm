# Copy to .env before `make up`. .env is gitignored; this file is not, which is
# why it carries development placeholders and no real credential.

# Postgres
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction
POSTGRES_DB=auction
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# auctiond
HTTP_PORT=8080
DB_POOL_SIZE=25
STRATEGY=optimistic

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
